      "html": "<span class=\"ds-codex-sticker\" aria-hidden=\"true\"><img class=\"ds-codex-sticker-light\" src=\"/assets/legal-codex-stickers/document-v2-light.webp\" width=\"256\" height=\"256\" alt=\"\" loading=\"lazy\" decoding=\"async\"><img class=\"ds-codex-sticker-dark\" src=\"/assets/legal-codex-stickers/document-v2-dark.webp\" width=\"256\" height=\"256\" alt=\"\" loading=\"lazy\" decoding=\"async\"></span>",
