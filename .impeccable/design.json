  "narrative": {
    "northStar": "Legal Codex（法律典籍）",
    "overview": "以法律典籍的沉穩、精準與學術感呈現公開案例。介面首先讓使用者辨認所在位置、搜尋範圍與資料來源，再閱讀分析結果。此文件記錄現有品牌與實作，不另立替代風格。",
    "keyCharacteristics": [
      "暖米白紙面、深海軍藍文字、節制的琥珀金提示。",
      "襯線標題配合清楚的資料標籤與表格。",
      "圖表優先呈現資料與範圍，保留九種法院識別色。",
      "共用操作、狀態與尺寸規則，讓不同頁面可以預期。"
    ],
    "rules": [
      {
        "name": "The Paired Contrast Rule",
        "body": "實心重點底色搭配 `--color-on-solid`，由主題決定前景，不將白字固定套用到深色模式的亮琥珀底色。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 保留資料、來源連結、法院分類與所有主要操作。",
      "Do 從 `tokens.json` 取得顏色、間距、圓角與陰影。",
      "Do 在英文、繁體中文及明暗主題下檢查窄螢幕與鍵盤操作。"
    ],
    "donts": [
      "Don't 用通用行銷頁模板取代現有研究介面。",
      "Don't 隱藏主要功能來掩飾手機版溢出。",
      "Don't 編造新聞、案例數量、來源或驗證結果。"
    ]
  }
}
