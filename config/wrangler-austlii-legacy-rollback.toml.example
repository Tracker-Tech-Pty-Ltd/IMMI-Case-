# Legacy rollback-only pipeline configuration. Native production deploys use
# workers/austlii-scraper/wrangler.toml and must never read this file.
name = "austlii-scraper-legacy-rollback"
main = "workers/austlii-scraper/src/index.ts"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

[[hyperdrive]]
binding = "HYPERDRIVE_SERVICE"
id = "REPLACE_WITH_LEGACY_PIPELINE_HYPERDRIVE_ID"
localConnectionString = "postgresql://postgres:postgres@localhost:5432/immi_case"

[[services]]
binding = "FLASK_BACKEND"
service = "immi-case"
entrypoint = "FlaskBackend"
remote = true

[vars]
PIPELINE_ENABLED = "false"
NATIVE_PIPELINE_ENABLED = "false"
